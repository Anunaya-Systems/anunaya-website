---
const email = "hello@anunaya.in";
const domain = "anunaya.in";

const capabilities = [
	{
		n: "01",
		title: "AI Infrastructure",
		body: "The foundational layer for building, deploying, and operating AI systems — built to scale from a single agent to a fleet.",
	},
	{
		n: "02",
		title: "Durable Long-Running Agents",
		body: "Agents that survive restarts, network failures, and long idle periods, picking up exactly where they left off.",
	},
	{
		n: "03",
		title: "Sandbox Environments",
		body: "Isolated, disposable execution environments for agents to run code and take action safely.",
	},
	{
		n: "04",
		title: "Persistent Storage",
		body: "State and memory that outlive a single run, so agents keep context across sessions and restarts.",
	},
	{
		n: "05",
		title: "Software Services",
		body: "The supporting services and tooling teams need to ship agent-driven products with confidence.",
	},
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Anunaya Systems — AI Infrastructure for Durable Agents</title>
		<meta
			name="description"
			content="Anunaya Systems provides AI infrastructure, durable long-running AI agents, sandbox environments, persistent storage, and software services."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="nav">
			<div class="nav-inner">
				<a href="/" class="logo">Anunaya Systems</a>
				<nav class="nav-links">
					<a href="#capabilities">Capabilities</a>
					<a href="#contact">Contact</a>
				</nav>
				<a class="btn btn-primary" href={`mailto:${email}`}>Get in touch</a>
			</div>
		</header>

		<main>
			<section class="hero">
				<p class="mono-label">AI INFRASTRUCTURE</p>
				<h1>Infrastructure for AI agents that run — and keep running.</h1>
				<p class="hero-sub">
					Anunaya Systems builds the foundation for durable, long-running AI
					agents: sandboxed execution, persistent storage, and the software
					services to operate them reliably.
				</p>
				<div class="hero-cta">
					<a class="btn btn-primary" href={`mailto:${email}`}>Talk to us</a>
					<a class="btn btn-secondary" href="#capabilities">See what we build →</a>
				</div>
			</section>

			<section class="capabilities" id="capabilities">
				<div class="capabilities-grid">
					{
						capabilities.map((c) => (
							<div class="capability-card">
								<span class="capability-n">{c.n}</span>
								<h3>{c.title}</h3>
								<p>{c.body}</p>
							</div>
						))
					}
				</div>
			</section>

			<section class="cta-band" id="contact">
				<h2>Let's build something durable.</h2>
				<p>Reach us at <a href={`mailto:${email}`}>{email}</a></p>
				<a class="btn btn-primary btn-light" href={`mailto:${email}`}>
					Email {email}
				</a>
			</section>
		</main>

		<footer>
			<div class="footer-inner">
				<span class="footer-logo">Anunaya Systems</span>
				<div class="footer-links">
					<a href={`https://${domain}`}>{domain}</a>
					<a href={`mailto:${email}`}>{email}</a>
				</div>
				<span class="footer-copy">© 2026 Anunaya Systems</span>
			</div>
		</footer>
	</body>
</html>

<style>
	:root {
		--color-black: #000000;
		--color-near-black: #17171c;
		--color-coral: #ff7759;
		--color-canvas: #ffffff;
		--color-card-border: #f2f2f2;
		--color-ink: #212121;
		--color-muted-slate: #93939f;
		--color-hairline: #d9d9dd;
		--color-focus: #4c6ee6;

		--font-display: "Space Grotesk", "Inter", ui-sans-serif, system-ui, sans-serif;
		--font-body: "Inter", ui-sans-serif, system-ui, sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
	}

	body {
		background: var(--color-canvas);
		color: var(--color-ink);
		font-family: var(--font-body);
		font-size: 16px;
		line-height: 1.5;
		-webkit-font-smoothing: antialiased;
	}

	a {
		color: inherit;
	}

	a:focus-visible,
	button:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 2px;
	}

	h1,
	h2,
	h3 {
		font-family: var(--font-display);
		font-weight: 400;
		margin: 0;
	}

	/* Nav */
	.nav {
		border-bottom: 1px solid var(--color-hairline);
	}

	.nav-inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 20px 24px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}

	.logo {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 18px;
		letter-spacing: -0.2px;
		text-decoration: none;
	}

	.nav-links {
		display: flex;
		gap: 32px;
		flex: 1;
		justify-content: center;
	}

	.nav-links a {
		text-decoration: none;
		font-size: 14px;
		color: var(--color-ink);
	}

	.nav-links a:hover {
		color: var(--color-muted-slate);
	}

	/* Buttons */
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-body);
		font-size: 14px;
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
	}

	.btn-primary {
		background: var(--color-near-black);
		color: var(--color-canvas);
		padding: 12px 24px;
		border-radius: 32px;
	}

	.btn-primary:hover {
		background: var(--color-black);
	}

	.btn-primary.btn-light {
		background: var(--color-canvas);
		color: var(--color-near-black);
	}

	.btn-primary.btn-light:hover {
		background: var(--color-card-border);
	}

	.btn-secondary {
		padding: 12px 0;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* Hero */
	.hero {
		max-width: 800px;
		margin: 0 auto;
		padding: 96px 24px 80px;
		text-align: center;
	}

	.mono-label {
		font-family: "Space Grotesk", monospace;
		font-size: 14px;
		letter-spacing: 0.28px;
		text-transform: uppercase;
		color: var(--color-coral);
		margin: 0 0 20px;
	}

	.hero h1 {
		font-size: 56px;
		line-height: 1.05;
		letter-spacing: -1.12px;
		margin-bottom: 24px;
	}

	.hero-sub {
		font-size: 18px;
		line-height: 1.4;
		color: var(--color-muted-slate);
		margin: 0 auto 40px;
		max-width: 640px;
	}

	.hero-cta {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 24px;
	}

	/* Capabilities */
	.capabilities {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 24px 96px;
	}

	.capabilities-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 40px 32px;
	}

	.capability-card {
		padding-top: 24px;
		border-top: 1px solid var(--color-hairline);
	}

	.capability-n {
		font-family: "Space Grotesk", monospace;
		font-size: 14px;
		color: var(--color-coral);
		letter-spacing: 0.28px;
	}

	.capability-card h3 {
		font-size: 24px;
		line-height: 1.3;
		margin: 12px 0 8px;
	}

	.capability-card p {
		font-size: 16px;
		color: var(--color-muted-slate);
		margin: 0;
	}

	/* CTA band */
	.cta-band {
		background: var(--color-near-black);
		color: var(--color-canvas);
		text-align: center;
		padding: 80px 24px;
	}

	.cta-band h2 {
		font-size: 40px;
		letter-spacing: -0.8px;
		margin-bottom: 16px;
	}

	.cta-band p {
		font-size: 18px;
		color: #d9d9dd;
		margin: 0 0 32px;
	}

	.cta-band a[href^="mailto"] {
		text-decoration: underline;
	}

	.cta-band p a {
		text-decoration: underline;
	}

	/* Footer */
	footer {
		border-top: 1px solid var(--color-hairline);
	}

	.footer-inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 32px 24px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
	}

	.footer-logo {
		font-family: var(--font-display);
		font-size: 14px;
	}

	.footer-links {
		display: flex;
		gap: 24px;
	}

	.footer-links a {
		font-size: 14px;
		color: var(--color-muted-slate);
		text-decoration: none;
	}

	.footer-links a:hover {
		color: var(--color-ink);
	}

	.footer-copy {
		font-size: 12px;
		color: var(--color-muted-slate);
	}

	/* Responsive */
	@media (max-width: 1024px) {
		.capabilities-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 768px) {
		.nav-links {
			display: none;
		}

		.hero h1 {
			font-size: 40px;
			letter-spacing: -0.8px;
		}
	}

	@media (max-width: 640px) {
		.hero {
			padding: 64px 20px 56px;
		}

		.hero-cta {
			flex-direction: column;
			gap: 16px;
		}

		.capabilities-grid {
			grid-template-columns: 1fr;
		}

		.cta-band h2 {
			font-size: 28px;
		}

		.footer-inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
